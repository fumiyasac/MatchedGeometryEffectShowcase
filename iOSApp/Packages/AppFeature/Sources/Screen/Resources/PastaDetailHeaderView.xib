                <constraint firstAttribute="trailing" secondItem="pst-bar" secondAttribute="trailing" id="pst-bar-trail"/>
                <constraint firstAttribute="bottom" secondItem="pst-bar" secondAttribute="bottom" id="pst-bar-bot"/>
